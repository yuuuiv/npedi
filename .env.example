# 复制为 .env 后按需修改。只有 WEB_TOKEN 是必填项，其余留空即用默认值。
# 现有 .env 里的 `Web-Token = xxx` 写法同样能被识别，无需改动。

# ---- 必填 ----
# 浏览器 F12 → Application → Cookies → www.npedi.com → Web-Token 的值
# （或 Network 里任一 /onesite-api/ 请求头 ediAuthorization 中 Bearer 之后的部分）
WEB_TOKEN=

# ---- 接口 ----
BASE_URL=https://www.npedi.com
PAGE_SIZE=200
TIMEOUT_SECONDS=60
MAX_RETRIES=3
# 每轮开始用 getInfo 探活 token（1 次请求），失效时能立刻给出明确原因
AUTH_PROBE=true
# 请求间隔（毫秒，随机区间）。对方是口岸政务系统，不要调小
REQUEST_DELAY_MS=500-1000

# ---- 增量窗口 ----
# 每轮窗口 = [上次水位线 - 重叠, 现在 + 余量]，重叠用来兜住时钟偏移与乱序
COMPARE_WINDOW_OVERLAP_HOURS=2
FUTURE_MARGIN_HOURS=24
# 手动指定窗口（yyyyMMddHHmmss,yyyyMMddHHmmss），用于补数/重放；平时留空
COMPARE_WINDOW_MANUAL=

# ---- 降级路径（probe 判定假设 1 不成立时才用）的"活跃航次"口径 ----
ACTIVE_PAST_DAYS=7
ACTIVE_FUTURE_DAYS=14
ACTIVE_UNKNOWN_CLOSE_DAYS=14

# ---- 单轮请求预算保护 ----
MAX_NEW_VOYAGE_BACKFILL_PER_RUN=50
RECONCILE_MAX_VOYAGES=200

# ---- 兜底查询（架构 §5 安全网 2）----
# auto: 按 probe 结论决定；on: 强制开启；off: 关闭
EMPTY_COMPARE_FALLBACK=auto

# ---- 输出 ----
DB_PATH=./npedi.sqlite
EXPORT_DIR=./export
LOG_DIR=./logs
ALERT_FILE=./ALERT_TOKEN_EXPIRED
# iso: 20260727103201 → 2026-07-27 10:32:01（Excel 友好）；raw: 保持接口原样
CSV_TIMESTAMP_FORMAT=iso
# 保留最近多少个 changes_*.csv，0 表示不清理
CSV_KEEP_CHANGE_FILES=90
