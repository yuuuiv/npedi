# 复制为 .env 后按需修改。只有 WEB_TOKEN 是必填项，其余留空即用默认值。
# 现有 .env 里的 `Web-Token = xxx` 写法同样能被识别，无需改动。

# ---- 必填 ----
# 浏览器 F12 → Application → Cookies → www.npedi.com → Web-Token 的值
# （或 Network 里任一 /onesite-api/ 请求头 ediAuthorization 中 Bearer 之后的部分）
WEB_TOKEN=

# ---- 接口 ----
BASE_URL=https://www.npedi.com
PAGE_SIZE=200
TIMEOUT_SECONDS=60
MAX_RETRIES=3
# 每轮开始用 getInfo 探活 token（1 次请求），失效时能立刻给出明确原因
AUTH_PROBE=true
# 请求间隔（毫秒，随机区间）。对方是口岸政务系统，不要调小
REQUEST_DELAY_MS=500-1000

# ---- 增量窗口 ----
# 每轮窗口 = [上次水位线 - 重叠, 现在 + 余量]，重叠用来兜住时钟偏移与乱序
COMPARE_WINDOW_OVERLAP_HOURS=2
FUTURE_MARGIN_HOURS=24
# 手动指定窗口（yyyyMMddHHmmss,yyyyMMddHHmmss），用于补数/重放；平时留空
COMPARE_WINDOW_MANUAL=

# ---- 降级路径（probe 判定假设 1 不成立时才用）的"活跃航次"口径 ----
ACTIVE_PAST_DAYS=7
ACTIVE_FUTURE_DAYS=14
ACTIVE_UNKNOWN_CLOSE_DAYS=14

# ---- 单轮请求预算保护 ----
MAX_NEW_VOYAGE_BACKFILL_PER_RUN=50
RECONCILE_MAX_VOYAGES=200

# ---- 兜底查询（架构 §5 安全网 2）----
# auto: 按 probe 结论决定；on: 强制开启；off: 关闭
EMPTY_COMPARE_FALLBACK=auto

# ---- 进出门（CODECO）管线，见 ARCHITECTURE-GATE.md ----
# 页大小与站点前端一致，不要调大
GATE_PAGE_SIZE=100
# 每次 gate-backfill 的请求预算，跑满即停，下次运行自动续跑；0=不限。
# 全量约需 6-12 万次请求（十几到三十几小时），所以按晚分次铺
GATE_BACKFILL_MAX_REQUESTS=5000
# 活跃航次连续多少轮增量没有新报文、且已离开 npp 在册目录，就不再查询
GATE_INCREMENTAL_INACTIVE_ROUNDS=6
# 不在 npp 目录里的航次（驳船系列），最近多少天有报文才算活跃
GATE_ACTIVE_DAYS=14
# 单轮增量里最多顺带整段回填多少个航次×方向
GATE_NEW_VOYAGE_LIMIT=200
# 全量快照 CSV：all=全部｜active=只导活跃航次｜off=不导（报文可能有数百万行）
GATE_EXPORT_SCOPE=all

# ---- 输出 ----
DB_PATH=./npedi.sqlite
EXPORT_DIR=./export
LOG_DIR=./logs
ALERT_FILE=./ALERT_TOKEN_EXPIRED
# iso: 20260727103201 → 2026-07-27 10:32:01（Excel 友好）；raw: 保持接口原样
CSV_TIMESTAMP_FORMAT=iso
# 保留最近多少个 changes_*.csv，0 表示不清理
CSV_KEEP_CHANGE_FILES=90
# 保留最近多少个单轮日志 logs/runs/*.log，0 表示不清理
LOG_KEEP_RUN_FILES=90

# Timeseries pipeline (reuses PAGE_SIZE, REQUEST_DELAY_MS, DB_PATH, EXPORT_DIR)
# SPI weights are renormalized when a component is missing.
SPI_VGM_WEIGHT=0.30
SPI_RELEASE_WEIGHT=0.20
SPI_TRANSSHIPMENT_WEIGHT=0.15
SPI_ARRIVAL_DELAY_WEIGHT=0.15
SPI_DEPARTURE_DELAY_WEIGHT=0.10
SPI_PLAN_REVISION_WEIGHT=0.10

# ---- Automatic SMS login (disabled until every value is configured) ----
AUTO_LOGIN=false
NPEDI_MOBILE=
# Local command invoked as: <command> <temporary-captcha-jpeg>.
# Train the NPEDI CNN first; see docs/auto-login.md.
CAPTCHA_SOLVER_COMMAND=.captcha-cnn-venv\Scripts\python.exe scripts\solve_npedi_captcha_cnn.py
CAPTCHA_SOLVER_TIMEOUT_SECONDS=30
CAPTCHA_ATTEMPTS=3

# OTP source: temp_mail or telegram.
OTP_READER_BACKEND=temp_mail

# yuuuiv/temp-mail / cloudflare_temp_email Worker read-only mailbox API.
TEMP_MAIL_BASE_URL=
TEMP_MAIL_ADDRESS_JWT=
TEMP_MAIL_SITE_PASSWORD=
TEMP_MAIL_RECIPIENT=
TEMP_MAIL_ALLOWED_SENDER=support@neofantasy.online
TEMP_MAIL_REQUIRED_TEXT=宁波舟山港
# SmsForwarder sends every SMS email twice; require both distinct messages.
TEMP_MAIL_REQUIRED_COPIES=2
TEMP_MAIL_POLL_SECONDS=3

# SmsForwarder sends with Bot A. This program reads with a separate Bot B in
# the same private group; configure Telegram Bot-to-Bot Communication Mode.
TELEGRAM_READER_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SMS_SENDER_BOT_ID=
SMS_CODE_PATTERN=(?<!\d)(\d{4,8})(?!\d)
SMS_CODE_TIMEOUT_SECONDS=180
